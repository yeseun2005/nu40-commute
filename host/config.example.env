# ─────────────────────────────────────────────────────────────
# 출근 알림 보드 설정 (예시)
#
# 이 파일을 같은 폴더에 ".env" 로 복사한 뒤 값을 채우세요.
#   윈도우:     copy host\config.example.env host\.env
#   맥/리눅스:  cp host/config.example.env host/.env
#
# 프로젝트 루트의 .env 도 함께 읽습니다. 같은 항목은 host/.env 가 우선합니다.
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 키를 남에게 보여주지 마세요.
# ─────────────────────────────────────────────────────────────

# 서울 열린데이터광장(data.seoul.go.kr) 인증키
#   SEOUL_SUBWAY_KEY   : 일반 인증키 (시간표·역코드)
#   SEOUL_REALTIME_KEY : 실시간 지하철 인증키 (비우면 일반 키로 시도)
# 데모 모드(--demo)만 쓸 거면 둘 다 비워 둬도 됩니다.
SEOUL_SUBWAY_KEY=
SEOUL_REALTIME_KEY=

# 보드가 꽂힌 시리얼 포트. 비워 두면 알아서 찾습니다.
#   윈도우: COM3    맥: /dev/cu.usbmodem1101
SERIAL_PORT=

# 출발역·방면 (공덕역 6호선 효창공원앞 방면)
# 다른 역은 tools/find_station.py 역이름 으로 찾으세요.
STATION_NAME=공덕
STATION_CODE=2627
SUBWAY_ID=1006
UPDN_LINE=하행
LINE_HINT=효창공원앞방면

# 집 → 역 도보 시간(분)과 여유(분). 출발선 = 도착 − (도보 + 여유)
WALK_MINUTES=15
BUFFER_MINUTES=1

# 출근 마감 모드: 마감에 맞는 열차 중 가장 늦은 열차를 고릅니다.
# ARRIVE_BY 를 비우면 "지금 탈 수 있는 첫 열차"를 고릅니다 (원본 방식).
ARRIVE_BY=17:00
RIDE_MINUTES=15
DEST_WALK_MINUTES=5
ARRIVE_EARLY_MINUTES=5

# 화면이 자동으로 켜지는 시간대와 요일. 이 밖에선 화면을 끄고 API 도 부르지 않습니다.
# 24시간제 HH:MM. 시간 둘 다 비우면 항상 켬. 요일 비우면 매일.
ON_AT=15:40
OFF_AT=16:40
WORK_DAYS=월,수,금

# 실시간 도착정보를 몇 초마다 부를지 (최소 30, 기본 60). 하루 한도가 약 1,000건입니다.
REALTIME_POLL_SECONDS=60

# 공휴일 (휴일 시간표를 쓸 날짜). 쉼표로 구분, YYYY-MM-DD.
HOLIDAYS=

# 데모 모드 배속 (--demo)
DEMO_SPEED=8
